# ForgeClaw local / operator environment sample.
# Copy to `.env` (gitignored). Never commit real secrets.

# Optional local OpenAI key (Settings UI is preferred for browser).
OPENAI_API_KEY=sk-...or-sk-proj-...

# GitHub PAT for NEXUS/ForgeClaw repository operations in local Vite dev.
# Exposed to the browser only if prefixed with VITE_ (Vite embeds VITE_* in the client bundle).
# DO NOT set VITE_GITHUB_TOKEN in the public GitHub Pages production build — it would publish the token.
# Recommended scopes: repo (or fine-grained: Contents read/write on DeviousDevv303/forgeclaw).
# After first load, the app can seed localStorage `gh_token` so you do not re-paste every session.
VITE_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Non-VITE alias is NOT available to the browser bundle (server/tooling only).
# GITHUB_TOKEN=
